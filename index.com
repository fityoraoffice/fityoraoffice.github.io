  .btn2{display:block;background:#111!important;border:1px solid #333;color:#fff!important;text-decoration:none;padding:14px;border-radius:12px;margin-top:10px;font-weight:bold}
  details{background:#1a1a1a!important;border:1px solid #222;border-radius:10px;padding:12px;margin:8px 0;text-align:left}
  summary{cursor:pointer;font-weight:bold}
  .footer{color:#888;font-size:12px;margin:30px 0;line-height:1.7}
</style>
</head>
